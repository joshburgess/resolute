{
  "name": "pg-wired",
  "version": "0.1.0",
  "description": "High-performance native PostgreSQL driver for Node.js, Bun, and Deno, binding the pg-wired Rust wire-protocol implementation via napi-rs.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "napi": {
    "name": "pg-wired",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "aarch64-pc-windows-msvc",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "files": ["index.js", "index.d.ts", "lib/", "README.md"],
  "license": "(MIT OR Apache-2.0)",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">= 22.6"
  },
  "scripts": {
    "build": "napi build --platform --release && tsc",
    "build:debug": "napi build --platform && tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node --test __test__/*.test.mts",
    "test:bun": "bun test __test__/smoke.test.mts",
    "test:deno": "deno test --allow-all --unstable-node-globals --unstable-detect-cjs --no-check __test__/smoke.test.mts",
    "test:matrix": "node scripts/test-matrix.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
